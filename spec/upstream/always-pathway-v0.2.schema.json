{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alwaysfoundation.org/spec/v0.2/handoff-standard.schema.json",
  "title": "Always Pathway standard v0.2 (formerly the Always Handoff standard)",
  "description": "Open standard for passing a consenting person from a sending ministry to a receiving church or ministry, in any country. Text CC BY 4.0. Draws on ISO/IEC TS 27560 (consent), HL7 FHIR ServiceRequest/Task (lifecycle) and Open Referral HSDS (directory). v0.2 generalises v0.1 (the Australian profile) with ISO 3166-1 country codes, free-form regions and postal codes, E.164 phone numbers and worldwide coordinates.",
  "$defs": {
    "AgeBand": {
      "enum": [
        "under13",
        "13-14",
        "15-17",
        "18+"
      ]
    },
    "StepCategory": {
      "enum": [
        "church",
        "explore",
        "talk",
        "youth",
        "group",
        "help",
        "read"
      ]
    },
    "Organisation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "displayName",
        "trustLevel",
        "country"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "church",
            "ministry",
            "network"
          ]
        },
        "displayName": {
          "type": "string",
          "maxLength": 160
        },
        "denomination": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "trustLevel": {
          "enum": [
            "listed",
            "claimed",
            "verified",
            "verified_youth"
          ]
        },
        "suburb": {
          "type": "string",
          "description": "Suburb, town or locality."
        },
        "location": {
          "$ref": "#/$defs/GeoPoint"
        },
        "website": {
          "type": "string",
          "format": "uri"
        },
        "offers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepCategory"
          }
        },
        "lastConfirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code."
        },
        "region": {
          "type": "string",
          "maxLength": 80,
          "description": "State, province or region, as used locally."
        },
        "postalCode": {
          "type": "string",
          "maxLength": 12
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "BCP 47 language tag."
          },
          "description": "Languages the organisation can welcome people in."
        }
      }
    },
    "GeoPoint": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "Consent": {
      "type": "object",
      "required": [
        "id",
        "purposes",
        "recipients",
        "wordingVersion",
        "party",
        "ageBand",
        "collectedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "connect.church",
              "notify.sender",
              "resources",
              "stats.anonymous"
            ]
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "allowNextNearby": {
          "type": "boolean",
          "default": false
        },
        "wordingVersion": {
          "type": "string"
        },
        "party": {
          "enum": [
            "self",
            "parent"
          ]
        },
        "ageBand": {
          "$ref": "#/$defs/AgeBand"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentConfirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "withdrawnAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Response": {
      "type": "object",
      "required": [
        "ageBand",
        "step",
        "consent"
      ],
      "properties": {
        "firstName": {
          "type": "string",
          "maxLength": 60,
          "description": "Restricted. Omitted for under-13s (parent details only)."
        },
        "contact": {
          "type": "object",
          "properties": {
            "mobile": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{6,14}$",
              "description": "E.164 format."
            },
            "email": {
              "type": "string",
              "format": "email"
            }
          },
          "description": "Restricted. One method."
        },
        "suburb": {
          "type": "string"
        },
        "ageBand": {
          "$ref": "#/$defs/AgeBand"
        },
        "step": {
          "$ref": "#/$defs/StepCategory"
        },
        "language": {
          "type": "string",
          "description": "BCP 47 language tag the person prefers."
        },
        "campaignId": {
          "type": "string",
          "format": "uuid"
        },
        "placementId": {
          "type": "string",
          "format": "uuid"
        },
        "consent": {
          "$ref": "#/$defs/Consent"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": "string",
          "maxLength": 80
        },
        "postalCode": {
          "type": "string",
          "maxLength": 12
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ageBand": {
                "const": "under13"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "firstName"
              ]
            }
          }
        }
      ]
    },
    "HandoffEvent": {
      "type": "object",
      "description": "CloudEvents 1.0 envelope; data carries status only, never personal details.",
      "required": [
        "specversion",
        "type",
        "source",
        "id",
        "time",
        "data"
      ],
      "properties": {
        "specversion": {
          "const": "1.0"
        },
        "type": {
          "enum": [
            "handoff.offered",
            "handoff.accepted",
            "handoff.passed",
            "handoff.expired",
            "handoff.rerouted",
            "handoff.status_changed",
            "consent.withdrawn",
            "person.deleted",
            "organisation.verified",
            "organisation.suspended"
          ]
        },
        "source": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "properties": {
            "handoffId": {
              "type": "string",
              "format": "uuid"
            },
            "orgId": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "enum": [
                "awaiting_parent",
                "routing",
                "offered",
                "accepted",
                "contacted",
                "care_team",
                "closed",
                "withdrawn"
              ]
            },
            "status": {
              "enum": [
                "contacted",
                "met_up",
                "came_on_sunday",
                "joined_group",
                "not_ready",
                "asked_to_stop"
              ]
            },
            "passReason": {
              "enum": [
                "capacity",
                "language",
                "fit",
                "safeguarding",
                "other"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
